# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# never commit real secrets or local secret files
.env
.env.*
!.env.example
.secrefs.local.json

# control plane local dev database (org vault connections, encrypted at
# rest or not - never belongs in git)
*.sqlite3
*.sqlite3-*

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test/coverage
coverage/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
dist-python/

# infra
cdk.out/
*.tfstate
*.tfstate.*
.terraform/

# terraform.tfvars holds the RDS password and any provider tokens. The
# runbook tells you to `cp terraform.tfvars.example terraform.tfvars`,
# so this file WILL exist on any machine that has deployed - it must
# never be the thing a stray `git add -A` picks up.
*.tfvars
*.tfvars.json
!*.tfvars.example

# CDK caches account ids and hosted-zone lookups here. It is a local
# cache, not source: committing it publishes the AWS account id and
# pins stale lookups that break a later deploy.
cdk.context.json

# editors/os
.DS_Store
.vscode/
.idea/
