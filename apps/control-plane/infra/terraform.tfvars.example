# Copy to terraform.tfvars and adjust. Every variable has a default that
# works — there is nothing here you are *required* to set, unlike the
# armory-swap stack, because no secret value is an input to this one.

api_domain = "api.secrefs.com"

# Who can reach the load balancer. Leave unset (the whole internet) for a
# launched API. Narrow it to your own address for the window between the
# first apply and setting real WORKOS_* secrets — until those exist the
# app boots with every management endpoint unauthenticated.
#   curl -s https://checkip.amazonaws.com   → your current address
# alb_allowed_cidrs = ["203.0.113.4/32"]

# Origins the admin console is served from. Leave empty until it exists —
# an empty list means the app emits no CORS headers at all.
# cors_origins = ["https://admin.secrefs.com"]

# Real KMS envelope encryption (the production custody path). Set false to
# fall back to the static SECREFS_CP_CIPHER_KEY out of Secrets Manager.
# enable_kms_cipher = true

# Hardening, off by default (~$99/mo combined). Set public_instance = false
# together with at least one of these to make the box structurally
# unreachable rather than reachable-but-firewalled. Terraform refuses to
# plan a private instance with no egress path at all.
# public_instance      = false
# enable_nat_gateway   = true

# ~$66/mo for seven interface endpoints. Keeps Secrets Manager / KMS / STS
# traffic off the public internet entirely.
# enable_vpc_endpoints = true

# Set true before this holds anything you would mind losing.
# deletion_protection = false
