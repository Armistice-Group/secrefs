{
  "name": "@secrefs/control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "SecRefs control plane - org vault connections, RBAC, and scoped credential minting (v1: AWS Secrets Manager only). See docs/control-plane-design.md.",
  "license": "BUSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no linter configured)\" && exit 0",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.658.1",
    "@aws-sdk/client-secrets-manager": "^3.658.1",
    "@aws-sdk/client-sts": "^3.658.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@workos-inc/node": "^10.12.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.0.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
