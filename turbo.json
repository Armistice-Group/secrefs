{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_CONTROL_PLANE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      // Turbo strips env vars it isn't told about, so without this the
      // control plane's Postgres tests skip themselves even when a
      // server is running - silently passing by not running, which is
      // the exact failure they exist to catch. Also part of the cache
      // key, so toggling it re-runs rather than replaying a cached
      // SQLite-only result.
      "env": ["SECREFS_TEST_DATABASE_URL"]
    },
    "typecheck": {
      // "build" (not just "^build") because the Next apps put generated
      // route types in .next/types and reference them from tsconfig's
      // `include`. Without this, typecheck and build race inside the same
      // package: typecheck passes when it happens to lose and finds the
      // types already written, and fails with TS6053 when it wins.
      "dependsOn": ["^build", "build"]
    },
    "clean": {
      "cache": false
    }
  }
}
